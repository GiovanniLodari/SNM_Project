# Credenziali: sia .env che env (senza punto) contengono i token Mastodon.
# Lo slash iniziale ancora il pattern alla root, cosi' non esclude per sbaglio
# eventuali directory chiamate env/ piu' in basso nell'albero.
.env
.env.*
/env
# env.example / .env.example sono template a valori vuoti: vanno tracciati.
!env.example
!.env.example
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.db
DB/*.db


# Claude Code / agent tooling
.claude/
.claude.json
.superpowers/
CLAUDE.md
CLAUDE.local.md

# Graphify knowledge graph output
graphify-out/
graph-out/

# Vecchia cartella fase_1_beta (analisi preliminare di un collega) - non
# esiste piu' sul disco, tolta dal tracking (era rimasta solo nell'indice git)
fase_1_beta/

# Fast-DetectGPT (external tool, fase 1 AI detection) - non tracciato.
# E' un repo git annidato (ha il proprio .git) - un file al suo interno non
# si puo' "detracciare" dal repo esterno senza diventare un embedded
# repo/submodule. Il risultato finale (ai_scores.jsonl) va quindi copiato
# in data/ (fuori da questo repo annidato) per essere tracciato normalmente.
fast-detect-gpt/

# AdaDetectGPT (external tool, fase 1 AI detection) - stesso motivo di
# fast-detect-gpt/ sopra: repo git annidato, non tracciato.
AdaDetectGPT/

# Copia di lavoro dei codici del "fisso" (secondo PC, esegue l'AI detection
# su GPU) - non tracciato, stesso motivo di fast-detect-gpt/
fisso/

# Modelli HuggingFace scaricati per checkworthiness (fase 2 fact-check) - non tracciato
cache/

