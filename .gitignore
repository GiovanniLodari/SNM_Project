*.aux
*.log
*.toc
report*.docx
report*.txt
report_*.docx
report_*.txt

# Project docs (specs/plans) - kept local, not pushed
docs/

# Tests - kept local, not pushed
tests/

# File PID e log del supervisore pipeline (webapp/jobs.py) - stato locale
.pids/
.logs/

# Export/import DB per condivisione dati con colleghi - stato locale
exports/
imports/

