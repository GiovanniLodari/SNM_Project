# Token per instances.social (discovery istanze per topic)
INSTANCES_SOCIAL_API=

# Token di accesso Mastodon per istanza.
# Nome variabile: MASTODON_TOKEN_<DOMINIO NORMALIZZATO>
# Normalizzazione: maiuscolo, ogni carattere non alfanumerico -> "_"
# Esempio per mastodon.social:
MASTODON_TOKEN_MASTODON_SOCIAL=

# Stringa di connessione Postgres
DATABASE_URL=postgresql://localhost:5432/snm

# Solo per i test di integrazione dello storage layer (facoltativa)
TEST_DATABASE_URL=postgresql://localhost:5432/snm_test
