# Template delle credenziali. Copiare in `.env` e riempire i valori.
#   cp env.example .env
# Il file `.env` non e' tracciato da git: non committarlo mai.

# API key per la discovery di istanze: https://instances.social/api/token
INSTANCES_SOCIAL_API=

# Connessione al database.
# PostgreSQL:
# DATABASE_URL=postgresql://utente:password@localhost:5432/snm
# SQLite (locale, nessuna installazione richiesta):
DATABASE_URL=sqlite:///DB/snm.db

# Token di accesso Mastodon, uno per istanza.
# Il nome della variabile si ricava dal dominio: i caratteri non alfanumerici
# diventano `_` e il tutto va in maiuscolo, con prefisso MASTODON_TOKEN_
# (vedi snm/config.py::normalize_domain). Esempio:
#   mastodon.social -> MASTODON_TOKEN_MASTODON_SOCIAL
# Per generarli: https://<istanza>/settings/applications
# Sono opzionali: senza token si usa l'accesso anonimo, che consente comunque
# le timeline hashtag e la ricerca (endpoint pubblici), ma con rate limit piu'
# basso (vedi snm/config.py::get_optional_token).
MASTODON_TOKEN_MASTODON_SOCIAL=
MASTODON_TOKEN_MASTODON_BIDA_IM=
MASTODON_TOKEN_INDUCTIVE_SPACE=
MASTODON_TOKEN_BIGSHOULDERS_CITY=
MASTODON_TOKEN_SUNNY_GARDEN=
MASTODON_TOKEN_BLIMPS_XYZ=
MASTODON_TOKEN_EFDN_CLUB=
MASTODON_TOKEN_EPSOM_SOCIAL=
